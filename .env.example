# Unicenta POS MySQL Database
UNICENTA_DB_HOST=localhost
UNICENTA_DB_PORT=3306
UNICENTA_DB_USER=root
UNICENTA_DB_PASSWORD=password
UNICENTA_DB_NAME=unicentaopos

# ERPNext Instance
ERPNEXT_URL=https://your-instance.erpnext.com
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret

# Sync Options
SYNC_PRODUCTS=true
SYNC_SALES=true
PRODUCT_SYNC_DIRECTION=unicenta_to_erpnext
SALES_SYNC_SINCE_DAYS=7
